# VaiCar Web Platform - Environment Variables Template
# Copy to .env for local development

# Google Maps API Key (JavaScript API, Places, Geocoding, Directions)
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Backend Server Configuration
PORT=5001
NODE_ENV=development

# Firebase Admin SDK Configuration (Optional in local dev - automatic high-fidelity in-memory fallback enabled)
FIREBASE_PROJECT_ID=vaicar-app-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@vaicar-app-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=vaicar-app-prod.appspot.com

# Transactional Email (SMTP / Nodemailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_key_here
EMAIL_FROM="VaiCar Notificações <nao-responda@vaicar.app>"
