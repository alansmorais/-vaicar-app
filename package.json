    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "nodemailer": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.2.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
